[20.200866, "o", "\r\n"]
[20.801121, "o", "\r\n  \u001b[38;5;42m✓\u001b[0m Gecko      will it work?        simulated, bound, PASS\r\n"]
[21.301375, "o", "  \u001b[38;5;42m✓\u001b[0m the wallet  who signs it?        the agentic wallet did\r\n"]
[21.801424, "o", "  \u001b[38;5;42m✓\u001b[0m the policy  are you allowed?     single-tx limit, enforced\r\n"]
[22.80158, "o", "\r\n"]
[23.701739, "o", "  Gecko never held a key and never broadcast anything.\r\n"]
[24.501962, "o", "\u001b[38;5;220mVerification is not authorization. Both had to say yes.\u001b[0m\r\n"]
