[21.283532, "o", "\r\n  \u001b[38;5;42m✓\u001b[0m Gecko      will it work?        simulated, bound, PASS\r\n"]
[21.783802, "o", "  \u001b[38;5;42m✓\u001b[0m the wallet  who signs it?        the agentic wallet did\r\n"]
[22.283691, "o", "  \u001b[38;5;42m✓\u001b[0m the policy  are you allowed?     single-tx limit, enforced\r\n"]
[23.283939, "o", "\r\n"]
[24.184598, "o", "  Gecko never held a key and never broadcast anything.\r\n"]
