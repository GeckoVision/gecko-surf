[18.1359, "o", "\r\n"]
[18.936147, "o", "\r\n\u001b[2m  bytes + IDL + source + live probes\u001b[0m   ─────▶   \u001b[1mgecko_graph\u001b[0m\r\n"]
[20.136475, "o", "\r\n  \u001b[1mthe lifecycle\u001b[0m — two chains, one shared account:\r\n"]
[20.73663, "o", "\r\n"]
[20.837169, "o", "    \u001b[38;5;45mopen_a_store\u001b[0m      initialize ──▶ add_product\r\n"]
[21.337294, "o", "    \u001b[38;5;45msell_and_deliver\u001b[0m  \u001b[38;5;42mmake_purchase\u001b[0m ──▶ mark_as_delivered\r\n"]
[21.837384, "o", "                      └── both write \u001b[1mreceipts\u001b[0m — a DATA edge, not advice:\r\n"]
[22.237857, "o", "                          mark_as_delivered settles a receipt_id only a landed\r\n"]
[22.537881, "o", "                          make_purchase writes\r\n"]
[23.737865, "o", "\r\n"]
[23.837974, "o", "  \u001b[1mthe accounts\u001b[0m — every one derived, each tagged with where it came from:\r\n"]
[24.438378, "o", "    receipts        PDA('receipts', store)   \u001b[38;5;42m[extracted]\u001b[0m ← the program's own IDL\r\n"]
[24.838733, "o", "    sender_ata      ATA(buyer, mint)         \u001b[38;5;42m[extracted]\u001b[0m ← declared, chain-verified\r\n"]
[25.238836, "o", "    recipient_ata   ATA(merchant, mint)      \u001b[38;5;42m[extracted]\u001b[0m\r\n"]
[25.638837, "o", "    …and 6 more     pinned program ids       \u001b[38;5;42m[extracted]\u001b[0m\r\n"]
[26.639052, "o", "\r\n\u001b[38;5;220m  the workflow graph Arazzo writes down for HTTP APIs — ours walks Solana\u001b[0m\r\n"]
[26.939299, "o", "\u001b[38;5;220m  programs too, and every edge carries its provenance and its refutation.\u001b[0m\r\n"]
