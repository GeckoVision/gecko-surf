[7.628896, "o", "\r\n"]
[9.090642, "o", "  builder: \u001b[38;5;42mHTTP 200\u001b[0m — a well-formed transaction came back\r\n"]
[10.407105, "o", "  simulate: \u001b[38;5;203m✗ FAIL\u001b[0m\r\n"]
[10.807347, "o", "    \u001b[38;5;203mProgram log: AnchorError caused by account: sender_token_account. Error Code: Accoun\u001b[0m\r\n"]
[12.007783, "o", "  \u001b[38;5;203mrevert class: account_error\u001b[0m\r\n"]
[13.407973, "o", "\r\n\u001b[38;5;220m  the builder said 200. the chain said no. transport cannot tell you\u001b[0m\r\n"]
[13.70834, "o", "\u001b[38;5;220m  the call is WRONG — and the first try was the real one.\u001b[0m\r\n"]
