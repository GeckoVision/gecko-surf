[14.735051, "o", "  \u001b[38;5;203m1\u001b[0m  mark_as_delivered declares its seed as \u001b[1mstore_name\u001b[0m.\r\n"]
[15.235123, "o", "     Its actual arguments are \u001b[1m_store_name\u001b[0m and receipt_id.\r\n"]
[15.735499, "o", "     \u001b[38;5;245mResolve seeds by argument name and you get nothing for the\u001b[0m\r\n"]
[16.135747, "o", "     \u001b[38;5;245mone seed that selects the store. Gecko binds by VALUE.\u001b[0m\r\n"]
[17.235874, "o", "\r\n"]
[18.136098, "o", "  \u001b[38;5;203m2\u001b[0m  the store's authority is writable but \u001b[1mnot a signer\u001b[0m.\r\n"]
[18.636373, "o", "     buyer pays from ATA(signer, mint) →\r\n"]
[18.936417, "o", "     store is credited at ATA(authority, mint)\r\n"]
[19.436544, "o", "     \u001b[38;5;245mSame mint. Different owner. Derive both from one owner\u001b[0m\r\n"]
[19.836917, "o", "     \u001b[38;5;245mand you have built a purchase that pays the buyer back.\u001b[0m\r\n"]
