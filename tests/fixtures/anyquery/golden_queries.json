          "orthogonal:predictleads:GET:/v3/companies/{company_id_or_domain}/technology_detections"
        ],
        "similar_companies": [
          "orthogonal:tomba:GET:/v1/similar"
        ]
      }
    }
  ],
  "refusals": [
    {
      "id": "out-of-catalog",
      "query": "What is the live score of the Flamengo match tonight",
      "subjects": [
        "Flamengo"
      ]
    }
  ]
