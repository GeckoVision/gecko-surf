                    "type": "string",
                    "const": "2.0",
                    "default": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "integer"
                    ],
                    "default": 1
                  },
                  "method": {
                    "type": "string",
                    "const": "getVersion",
                    "default": "getVersion"
                  },
                  "params": {
                    "type": "object",
                    "properties": {},
                    "default": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
