    "/estimateTransactionFee": {
      "post": {
        "operationId": "estimateTransactionFee",
        "tags": [
          "kora"
        ],
        "summary": "What this transaction will cost, in lamports and optionally in a token.",
        "description": "Simulates the transaction to price it. Nothing is signed and nothing is sent. fee_in_token is the number to show a user when the wallet holds no SOL.",
        "security": [
          {},
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "id",
                  "method",
                  "params"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "const": "2.0",
                    "default": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "integer"
                    ],
                    "default": 1
                  },
                  "method": {
                    "type": "string",
                    "const": "estimateTransactionFee",
                    "default": "estimateTransactionFee"
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "transaction"
                    ],
                    "properties": {
                      "transaction": {
                        "type": "string",
                        "description": "base64 serialized transaction"
                      },
                      "fee_token": {
                        "type": "string",
                        "description": "optional mint to price the fee in; omit for lamports only"
                      },
                      "signer_key": {
                        "type": "string",
                        "description": "optional fee payer to price against, for consistency"
                      },
                      "sig_verify": {
                        "type": "boolean",
                        "default": false,
                        "description": "verify signatures during simulation"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "type": "string"
                    },
                    "id": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "fee_in_lamports": {
                          "type": "integer",
                          "format": "int64",
                          "description": "the exact fee in lamports"
                        },
                        "fee_in_token": {
                          "type": "integer",
                          "format": "int64",
                          "description": "the fee in fee_token's base units, if fee_token was given"
                        },
                        "signer_pubkey": {
                          "type": "string",
                          "description": "the fee payer priced against"
                        },
                        "payment_address": {
                          "type": "string",
                          "description": "where the token fee should be sent"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/signTransaction": {
      "post": {
        "operationId": "signTransaction",
        "tags": [
          "kora"
        ],
        "summary": "Sign a transaction with the node's fee payer, without sending it.",
        "description": "MONEY MOVER. The node signs the exact bytes it is handed and returns them; the client then adds its own signature and sends. Prefer this over signAndSendTransaction when you want to check what you are sending.",
        "security": [
          {},
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "id",
                  "method",
                  "params"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "const": "2.0",
                    "default": "2.0"
                  },
                  "id": {
                    "type": [
                      "string",
                      "integer"
                    ],
                    "default": 1
                  },
                  "method": {
                    "type": "string",
                    "const": "signTransaction",
                    "default": "signTransaction"
                  },
                  "params": {
                    "type": "object",
                    "required": [
                      "transaction"
                    ],
                    "properties": {
                      "transaction": {
                        "type": "string",
                        "description": "base64 serialized transaction"
                      },
                      "signer_key": {
                        "type": "string",
                        "description": "optional fee payer to sign with"
                      },
                      "sig_verify": {
                        "type": "boolean",
                        "default": false
                      },
                      "user_id": {
                        "type": "string",
                        "description": "optional caller id for usage tracking"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "type": "string"
                    },
                    "id": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "signed_transaction": {
                          "type": "string",
                          "description": "base64 transaction signed by the fee payer"
                        },
                        "signer_pubkey": {
                          "type": "string",
                          "description": "the fee payer that signed"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
